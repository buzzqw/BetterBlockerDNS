<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy backup rules (Android 11 and lower).

  The settings DataStore contains the app-lock passcode/pattern and the
  database stores DNS query logs; neither should leave the device through
  an automatic backup. Users can still move their configuration with the
  in-app export/import feature in Settings > Privacy.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="database" path="." />
</full-backup-content>
