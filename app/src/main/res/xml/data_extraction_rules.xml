<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules.

  Exclude the settings DataStore (app-lock passcode/pattern) and the
  database with DNS query logs. The in-app export/import remains available
  for users who want to move their configuration to a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
