    <!-- Native catalogues (HaGeZi, StevenBlack) -->
    <string name="catalog_hagezi_light_desc">Basic protection. Blocks ads, trackers and telemetry with minimal breakage. Only domains from the Top 1M/10M lists.</string>
    <string name="catalog_hagezi_normal_desc">All-round protection. Ads, trackers, metrics, phishing, malware, scams and cryptojacking.</string>
    <string name="catalog_hagezi_pro_desc">Extended protection (recommended). Also blocks crash reporters and more telemetry. Low to moderate risk of breakage.</string>
    <string name="catalog_hagezi_pro_mini_desc">Size-optimised PRO for devices with limited RAM. Same idea, roughly half the entries.</string>
    <string name="catalog_hagezi_pro_plus_desc">Advanced protection. More aggressive than PRO, with a moderate risk of blocking legitimate domains.</string>
    <string name="catalog_hagezi_pro_plus_mini_desc">Size-optimised PRO++ for low-memory devices.</string>
    <string name="catalog_hagezi_ultimate_desc">Maximum protection. Very aggressive and can break apps or sites. Recommended only for experienced users.</string>
    <string name="catalog_hagezi_ultimate_mini_desc">Size-optimised ULTIMATE for low-memory devices.</string>
    <string name="catalog_hagezi_tif_desc">Threat Intelligence Feeds. A serious security boost against live malware, phishing and scam infrastructure. Works alongside any Multi tier.</string>
    <string name="catalog_hagezi_tif_medium_desc">Balanced Threat Intelligence Feeds: strong security coverage with fewer entries.</string>
    <string name="catalog_hagezi_tif_mini_desc">Compact Threat Intelligence Feeds for low-memory devices or slow connections.</string>
    <string name="catalog_hagezi_fake_desc">Blocks fake shops, scam sites, traps and fraudulent domains.</string>
    <string name="catalog_hagezi_popup_ads_desc">Blocks annoying and malicious pop-up ad infrastructure.</string>
    <string name="catalog_hagezi_dyndns_desc">Guards against dynamic DNS abuse often used by malware command-and-control.</string>
    <string name="catalog_hagezi_hoster_desc">Blocks hosting providers with a strong concentration of malicious content.</string>
    <string name="catalog_hagezi_spam_tlds_desc">Blocks top-level domains that are disproportionately used for spam and scams.</string>
    <string name="catalog_hagezi_doh_vpn_proxy_bypass_desc">Stops apps and browsers from bypassing your DNS filtering through DoH, VPNs, Tor or proxies.</string>
    <string name="catalog_hagezi_doh_desc">Only the DNS-over-HTTPS bypass entries, without the VPN/Tor/proxy part. Alternative to the full bypass list.</string>
    <string name="catalog_hagezi_url_shortener_desc">Blocks link shorteners often used to hide malicious destinations.</string>
    <string name="catalog_hagezi_anti_piracy_desc">Blocks piracy portals and their infrastructure. May also affect some streaming links.</string>
    <string name="catalog_hagezi_native_apple_desc">Blocks Apple device telemetry and tracking endpoints.</string>
    <string name="catalog_hagezi_native_samsung_desc">Blocks Samsung device telemetry and tracking endpoints.</string>
    <string name="catalog_hagezi_native_xiaomi_desc">Blocks Xiaomi/MIUI telemetry and tracking endpoints.</string>
    <string name="catalog_hagezi_native_tiktok_desc">Blocks TikTok\'s embedded tracking and telemetry endpoints.</string>
    <string name="catalog_hagezi_no_safesearch_desc">Blocks search engines and apps that do not respect SafeSearch.</string>
    <string name="catalog_hagezi_nsfw_desc">Blocks adult content.</string>
    <string name="catalog_hagezi_gambling_desc">Blocks gambling and betting sites.</string>
    <string name="catalog_hagezi_gambling_medium_desc">Medium-strength gambling filter.</string>
    <string name="catalog_hagezi_gambling_mini_desc">Compact gambling filter.</string>
    <string name="catalog_hagezi_social_desc">Blocks access to social networks.</string>
    <string name="catalog_stevenblack_unified_desc">Unified hosts file with ads, trackers and malware domains. The safest starting point of this catalogue.</string>
    <string name="catalog_stevenblack_fakenews_desc">Fake-news domains only. Combine with Unified or any other list.</string>
    <string name="catalog_stevenblack_gambling_desc">Gambling and betting domains only. Combine with Unified or any other list.</string>
    <string name="catalog_stevenblack_porn_desc">Adult content domains only. Combine with Unified or any other list.</string>
    <string name="catalog_stevenblack_social_desc">Social network domains only. Combine with Unified or any other list.</string>
    <string name="catalog_hagezi_category_core_title">Core protection</string>
    <string name="catalog_hagezi_category_core_desc">Pick exactly one Multi tier. Bigger tiers block more, with a higher chance of false positives.</string>
    <string name="catalog_hagezi_category_security_title">Security &amp; anti-abuse</string>
    <string name="catalog_hagezi_category_security_desc">Threat feeds and lists that stop scams, malware, DNS bypass and other abuse.</string>
    <string name="catalog_hagezi_category_privacy_title">Privacy &amp; telemetry</string>
    <string name="catalog_hagezi_category_privacy_desc">Reduces built-in trackers and telemetry emitted by devices, apps and platforms.</string>
    <string name="catalog_hagezi_category_family_title">Family &amp; content</string>
    <string name="catalog_hagezi_category_family_desc">Content filters for adult material, gambling, social networks and link shorteners.</string>
    <string name="catalog_hagezi_category_network_title">Network hygiene</string>
    <string name="catalog_hagezi_category_network_desc">Optional hardening for DNS rebinding, dynamic DNS abuse and bad hosting providers.</string>
    <string name="catalog_profile_essential_name">Essential</string>
    <string name="catalog_profile_essential_desc">Light browsing protection with a compact threat feed. Very low breakage.</string>
    <string name="catalog_profile_balanced_name">Balanced</string>
    <string name="catalog_profile_balanced_desc">All-round ad, tracker and malware blocking with a compact TIF.</string>
    <string name="catalog_profile_pro_name">Pro</string>
    <string name="catalog_profile_pro_desc">HaGeZi\'s recommended setup: Multi PRO plus the full Threat Intelligence Feed (TIF).</string>
    <string name="catalog_profile_aggressive_name">Aggressive</string>
    <string name="catalog_profile_aggressive_desc">Multi PRO++ plus the full TIF. Strong protection, some sites may need a manual allow rule.</string>
    <string name="catalog_profile_maximum_name">Maximum</string>
    <string name="catalog_profile_maximum_desc">Ultimate plus the full TIF. Only for users who want the strictest filtering.</string>
    <string name="catalog_stevenblack_category_unified_title">StevenBlack unified</string>
    <string name="catalog_stevenblack_category_unified_desc">The classic unified hosts file: ads, trackers and malware from reputable sources.</string>
    <string name="catalog_stevenblack_category_content_title">StevenBlack extensions</string>
    <string name="catalog_stevenblack_category_content_desc">Extension-only lists: stack as many as you like, on top of Unified or of a HaGeZi profile.</string>
