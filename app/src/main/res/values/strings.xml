    <string name="hagezi_native_catalogues_title">Native blocklist catalogues</string>
    <string name="hagezi_native_catalogues_desc">BBDNS ships HaGeZi and StevenBlack as first-class sources. Lists use the plain-domain or hosts format, are downloaded in the background and follow the same auto-update schedule as every other list.</string>
    <string name="hagezi_stevenblack_hosts_title">StevenBlack hosts</string>
    <string name="hagezi_stevenblack_hosts_desc">The classic unified hosts file plus optional fakenews, gambling, adult and social extensions.</string>
    <string name="hagezi_profiles_title">Protection profiles</string>
    <string name="hagezi_profiles_desc">One tap configures a complete selection. These profiles are all you need: they already include HaGeZi TIF, and StevenBlack Unified is a solid alternative.</string>
    <string name="hagezi_recommended_suffix">%1$s (recommended)</string>
    <string name="hagezi_stevenblack_alternative_title">StevenBlack Unified (extra list)</string>
    <string name="hagezi_stevenblack_alternative_desc">Classic unified hosts file with ads, trackers and malware. Can be added on top of any HaGeZi profile. The malware preset includes it automatically.</string>
    <string name="hagezi_compatibility_title">Compatibility</string>
    <string name="hagezi_compatibility_desc">Keeps banking, payments, identity providers, app stores and push notifications working.</string>
    <string name="hagezi_compatibility_allowlist_title">Compatibility allowlist</string>
    <string name="hagezi_compatibility_allowlist_desc">Adds a curated set of banking, payment, government, app-store and push-notification domains as allow rules. Recommended with aggressive lists.</string>
    <string name="hagezi_maintenance_title">Maintenance</string>
    <string name="hagezi_maintenance_desc">Remove every catalogue list without touching your custom rules.</string>
    <string name="hagezi_disable_all_title">Disable all catalogue lists</string>
    <string name="hagezi_disable_all_desc">Removes HaGeZi and StevenBlack entries from the active configuration and deletes their cached downloads.</string>
    <string name="hagezi_optional_lists_title">Optional individual lists</string>
