    <string name="dns_resolver_doh_on_desc">Encrypted DNS via %1$s. Restart protection to apply changes. Disable Android Private DNS to avoid conflicts.</string>
    <string name="dns_resolver_doh_off_desc">Encrypt DNS queries with an RFC 8484 endpoint. The selected plain DNS server is used only as a fallback.</string>
    <string name="dns_resolver_doh_provider_title">DoH provider</string>
    <string name="dns_resolver_private_dns_title">Android Private DNS</string>
    <string name="dns_resolver_private_dns_desc">Open the Android Private DNS settings. Keep it off so that DNS queries go through BBDNS.</string>
    <string name="dns_resolver_private_dns_doh_desc">Disable Private DNS in Android settings while using BBDNS DoH, otherwise the system resolver may bypass the app.</string>
    <string name="dns_resolver_private_dns_unavailable">Private DNS settings are not available on this device. Open Settings → Network &amp; internet → Private DNS.</string>
    <string name="dns_resolver_block_bypass_title">Block DNS bypass</string>
    <string name="dns_resolver_block_bypass_desc">Closes DNS-over-TLS and the known DNS-over-HTTPS endpoints, so browsers and apps cannot resolve names outside the filter. Turn Android Private DNS off first.</string>
    <string name="dns_resolver_safe_search_title">SafeSearch</string>
    <string name="dns_resolver_safe_search_desc">Forces Google, Bing and YouTube into SafeSearch or restricted mode through DNS, without decrypting any traffic. Turn it off if a page stops loading.</string>
    <string name="dns_resolver_notice_page_title">Notice page for blocked sites</string>
    <string name="dns_resolver_notice_page_desc">Answers a blocked site over plain HTTP with a page on the phone that explains the block and can let it through for 10 minutes. HTTPS sites cannot show it, because that would need to decrypt the connection.</string>

