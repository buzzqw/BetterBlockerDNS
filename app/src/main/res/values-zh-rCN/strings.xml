    <string name="catalog_hagezi_light_desc">基础保护。拦截广告、跟踪器和遥测，几乎不会造成问题。仅包含 Top 1M/10M 列表中的域名。</string>
    <string name="catalog_hagezi_normal_desc">全面保护。涵盖广告、跟踪器、统计、钓鱼、恶意软件、诈骗和挖矿劫持。</string>
    <string name="catalog_hagezi_pro_desc">扩展保护（推荐）。还会拦截崩溃报告和更多遥测。出现问题的风险低到中等。</string>
    <string name="catalog_hagezi_pro_mini_desc">针对内存较小设备优化体积的 PRO。思路相同，条目约为一半。</string>
    <string name="catalog_hagezi_pro_plus_desc">高级保护。比 PRO 更激进，有中等风险误拦合法域名。</string>
    <string name="catalog_hagezi_pro_plus_mini_desc">针对低内存设备优化体积的 PRO++。</string>
    <string name="catalog_hagezi_ultimate_desc">最强保护。非常激进，可能导致应用或网站无法正常使用。仅推荐有经验的用户。</string>
    <string name="catalog_hagezi_ultimate_mini_desc">针对低内存设备优化体积的 ULTIMATE。</string>
    <string name="catalog_hagezi_tif_desc">威胁情报源。大幅增强针对活跃恶意软件、钓鱼和诈骗基础设施的安全防护。可与任意 Multi 级别搭配使用。</string>
    <string name="catalog_hagezi_tif_medium_desc">均衡版威胁情报源：条目更少，安全覆盖依然出色。</string>
    <string name="catalog_hagezi_tif_mini_desc">紧凑版威胁情报源，适合低内存设备或慢速网络。</string>
    <string name="catalog_hagezi_fake_desc">拦截虚假商店、诈骗网站、陷阱和欺诈域名。</string>
    <string name="catalog_hagezi_popup_ads_desc">拦截烦人和恶意的弹窗广告基础设施。</string>
    <string name="catalog_hagezi_dyndns_desc">防范恶意软件命令与控制常用的动态 DNS 滥用。</string>
    <string name="catalog_hagezi_hoster_desc">拦截恶意内容高度集中的托管服务商。</string>
    <string name="catalog_hagezi_spam_tlds_desc">拦截被大量用于垃圾信息和诈骗的顶级域名。</string>
    <string name="catalog_hagezi_doh_vpn_proxy_bypass_desc">阻止应用和浏览器通过 DoH、VPN、Tor 或代理绕过你的 DNS 过滤。</string>
    <string name="catalog_hagezi_doh_desc">仅包含 DNS over HTTPS 绕过条目，不含 VPN/Tor/代理部分。可替代完整的绕过列表。</string>
    <string name="catalog_hagezi_url_shortener_desc">拦截常被用来隐藏恶意目标的短链接服务。</string>
    <string name="catalog_hagezi_anti_piracy_desc">拦截盗版门户及其基础设施。也可能影响部分流媒体链接。</string>
    <string name="catalog_hagezi_native_apple_desc">拦截 Apple 设备的遥测和跟踪端点。</string>
    <string name="catalog_hagezi_native_samsung_desc">拦截三星设备的遥测和跟踪端点。</string>
    <string name="catalog_hagezi_native_xiaomi_desc">拦截小米/MIUI 的遥测和跟踪端点。</string>
    <string name="catalog_hagezi_native_tiktok_desc">拦截 TikTok 内置的跟踪和遥测端点。</string>
    <string name="catalog_hagezi_no_safesearch_desc">拦截不遵守安全搜索的搜索引擎和应用。</string>
    <string name="catalog_hagezi_nsfw_desc">拦截成人内容。</string>
    <string name="catalog_hagezi_gambling_desc">拦截赌博和博彩网站。</string>
    <string name="catalog_hagezi_gambling_medium_desc">中等强度的赌博过滤。</string>
    <string name="catalog_hagezi_gambling_mini_desc">紧凑版赌博过滤。</string>
    <string name="catalog_hagezi_social_desc">拦截对社交网络的访问。</string>
    <string name="catalog_stevenblack_unified_desc">包含广告、跟踪器和恶意软件域名的统一 hosts 文件。本目录中最稳妥的起点。</string>
    <string name="catalog_stevenblack_fakenews_desc">仅假新闻域名。可与 Unified 或其他任意列表组合。</string>
    <string name="catalog_stevenblack_gambling_desc">仅赌博和博彩域名。可与 Unified 或其他任意列表组合。</string>
    <string name="catalog_stevenblack_porn_desc">仅成人内容域名。可与 Unified 或其他任意列表组合。</string>
    <string name="catalog_stevenblack_social_desc">仅社交网络域名。可与 Unified 或其他任意列表组合。</string>
    <string name="catalog_hagezi_category_core_title">核心保护</string>
    <string name="catalog_hagezi_category_core_desc">只选择一个 Multi 级别。级别越高拦截越多，误拦的可能也越大。</string>
    <string name="catalog_hagezi_category_security_title">安全与反滥用</string>
    <string name="catalog_hagezi_category_security_desc">阻止诈骗、恶意软件、DNS 绕过及其他滥用行为的威胁情报和列表。</string>
    <string name="catalog_hagezi_category_privacy_title">隐私与遥测</string>
    <string name="catalog_hagezi_category_privacy_desc">减少设备、应用和平台内置的跟踪器与遥测。</string>
    <string name="catalog_hagezi_category_family_title">家庭与内容</string>
    <string name="catalog_hagezi_category_family_desc">针对成人内容、赌博、社交网络和短链接的内容过滤。</string>
    <string name="catalog_hagezi_category_network_title">网络卫生</string>
    <string name="catalog_hagezi_category_network_desc">可选的加固项，防范 DNS 重绑定、动态 DNS 滥用和不良托管服务商。</string>
    <string name="catalog_profile_essential_name">基础</string>
    <string name="catalog_profile_essential_desc">轻量的浏览保护，附带紧凑的威胁情报源。极少出现问题。</string>
    <string name="catalog_profile_balanced_name">均衡</string>
    <string name="catalog_profile_balanced_desc">全面拦截广告、跟踪器和恶意软件，附带紧凑版 TIF。</string>
    <string name="catalog_profile_pro_name">专业</string>
    <string name="catalog_profile_pro_desc">HaGeZi 推荐配置：Multi PRO 加完整的威胁情报源（TIF）。</string>
    <string name="catalog_profile_aggressive_name">激进</string>
    <string name="catalog_profile_aggressive_desc">Multi PRO++ 加完整的 TIF。保护强度高，部分网站可能需要手动添加允许规则。</string>
    <string name="catalog_profile_maximum_name">最强</string>
    <string name="catalog_profile_maximum_desc">Ultimate 加完整的 TIF。仅适合需要最严格过滤的用户。</string>
